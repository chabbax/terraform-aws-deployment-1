{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Provides necessary permissions for pushing, pulling, and managing Docker images in the ECR repository",
      "Effect": "Allow",
      "Principal": {
        "AWS": ["${account_id}"]
      },
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:GetDownloadUrlForLayer",
        "ecr:GetLifecyclePolicy",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ]
    }
  ]
}
