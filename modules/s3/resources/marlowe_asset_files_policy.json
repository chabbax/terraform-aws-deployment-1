{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": "${asset_files_role_arn}"
        },
        "Action": [
          "s3:GetObject",
          "s3:PutObject",
          "s3:DeleteObject"
        ],
        "Resource": "${aws_s3_bucket_asset_files_arn}/*"
      },
      {
        "Effect": "Allow",
        "Principal": {
          "AWS": "${asset_files_role_arn}"
        },
        "Action": [
          "s3:PutObjectTagging",
          "s3:GetObjectTagging"
        ],
        "Resource": "${aws_s3_bucket_asset_files_arn}/*"
      }
    ]
  }