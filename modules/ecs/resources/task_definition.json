[
  {
    "image": "${service_ecr_image}:${service_ecr_image_tag}",
    "cpu": ${service_cpu},
    "memory": ${service_memory},
    "name": "${service_name}",
    "networkMode": "awsvpc",
    "environment": ${service_environment},
    "portMappings": [
      {
        "containerPort": ${service_container_port},
        "hostPort": ${service_container_port},
        "protocol": "tcp",
        "appProtocol": "http"
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "/ecs/${service_name}-${workspace}",
        "awslogs-region": "${aws_region}",
        "awslogs-stream-prefix": "ecs",
        "awslogs-create-group" : "true"
      }
    },
    "healthCheck": {
      "command": [
        "CMD-SHELL",
        "curl -f http://localhost:${service_container_port}${health_check_path} || exit 1"
      ],
      "interval": 30,
      "timeout": 5,
      "retries": 3,
      "startPeriod": 60
    }
  }
]
